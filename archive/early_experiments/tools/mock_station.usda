#usda 1.0
(
    defaultPrim = "FillStation"
)

def Xform "FillStation"
{
    def Scope "Looks"
    {
        def Material "Liquid"
        {
            token outputs:surface.connect = </FillStation/Looks/Liquid/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.3, 0.9)
                float inputs:opacity = 0.6
                token outputs:surface
            }
        }
        def Material "Glass"
        {
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.9)
            }
        }
    }
}
